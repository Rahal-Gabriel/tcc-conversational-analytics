{"id_interacao": "e0053647bc944b348195a0aa79bcf669", "momento_real": "2026-09-20T18:32:46+00:00", "data_simulacao": "2026-05-31", "evento": "entrada", "usuario": "avaliacao", "perfil": "administrativo", "pergunta": "Por que a taxa de ocupacao subiu na ultima semana?", "hash_anterior": "e3207fba87ec2dcd1014d2f1bc919519d024d512dbc0c3023fec55d44afd1641", "hash": "518c3d80556a97a50a11e00b1ba93c13daf26d449afb56227ecb796a7d28d20e"}
{"id_interacao": "e0053647bc944b348195a0aa79bcf669", "momento_real": "2026-09-20T18:32:59+00:00", "data_simulacao": "2026-05-31", "evento": "incorreto", "usuario": "avaliacao", "perfil": "administrativo", "pergunta": "Por que a taxa de ocupacao subiu na ultima semana?", "sql": "WITH weekly_occupancy AS (\n    SELECT \n        data, \n        taxa_ocupacao,\n        LAG(taxa_ocupacao) OVER (ORDER BY data) AS prev_taxa_ocupacao\n    FROM \n        gold.ocupacao_diaria\n    WHERE \n        data >= DATE('2026-05-31') - INTERVAL '7 days'\n)\nSELECT \n    data, \n    taxa_ocupacao,\n    prev_taxa_ocupacao,\n    taxa_ocupacao - prev_taxa_ocupacao AS diff_taxa_ocupacao\nFROM \n    weekly_occupancy\nWHERE \n    taxa_ocupacao > prev_taxa_ocupacao;", "motor": "local", "controle": null, "motivo": null, "hash_resultado": "0c190073e81758ae37822f64129517333e95a770996ba0e016fe2562ffe49309", "n_linhas": 4, "hash_anterior": "518c3d80556a97a50a11e00b1ba93c13daf26d449afb56227ecb796a7d28d20e", "hash": "88b164563ee369fbceb91b9ef0ea23416d07f6f1330b97712dd03f22ef8222fd"}
