{"id_interacao": "e51ada99abc44966a0a7ba5e15e049e1", "momento_real": "2026-09-20T18:40:00+00:00", "data_simulacao": "2026-05-31", "evento": "incorreto", "usuario": "avaliacao", "perfil": "administrativo", "pergunta": "Por que a taxa de ocupacao subiu na ultima semana?", "sql": "WITH weekly_occupancy AS (\n    SELECT \n        data, \n        taxa_ocupacao,\n        LAG(taxa_ocupacao) OVER (ORDER BY data) AS prev_taxa_ocupacao\n    FROM \n        gold.ocupacao_diaria\n    WHERE \n        data >= DATE('2026-05-31') - INTERVAL '7 days'\n)\nSELECT \n    data, \n    taxa_ocupacao,\n    prev_taxa_ocupacao,\n    taxa_ocupacao - prev_taxa_ocupacao AS diff_taxa_ocupacao\nFROM \n    weekly_occupancy\nWHERE \n    taxa_ocupacao > prev_taxa_ocupacao;", "motor": "local", "controle": null, "motivo": null, "hash_resultado": "0c190073e81758ae37822f64129517333e95a770996ba0e016fe2562ffe49309", "n_linhas": 4, "hash_anterior": "ecf7023cb36fc20d760f86281f743191da60c352feccab2cfc87ca15e6bda71f", "hash": "d16eb0d8cefac124afc50bdf4978644158c06ef791465fbcabf0f1d47f71aa64"}
