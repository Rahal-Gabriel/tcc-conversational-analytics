{"id_interacao": "8f019c6da4414178a8d92ab4a9880139", "momento_real": "2026-09-20T18:48:12+00:00", "data_simulacao": "2026-05-31", "evento": "incorreto", "usuario": "avaliacao", "perfil": "administrativo", "pergunta": "Por que a taxa de ocupacao subiu na ultima semana?", "sql": "SELECT \n    data, \n    taxa_ocupacao, \n    LAG(taxa_ocupacao) OVER (ORDER BY data) AS taxa_ocupacao_anterior,\n    taxa_ocupacao - LAG(taxa_ocupacao) OVER (ORDER BY data) AS variancia_taxa\nFROM \n    gold.ocupacao_diaria\nWHERE \n    data >= DATE('2026-05-31') - INTERVAL '7 days'\nORDER BY \n    data;", "motor": "local", "controle": null, "motivo": null, "hash_resultado": "4b730c4aea733fab0342755858f6dddd838cf08d63b7462015cfa0c357b2e378", "n_linhas": 8, "hash_anterior": "9ffb33b3a42bf862707d57e570ff19b36e4d28dc3b2ba894c086978b749a8ccd", "hash": "e51197dd75961464eb958be4febaf70cf1031270c97517be4463b44b70a786de"}
