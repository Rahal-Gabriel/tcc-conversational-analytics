{"id_interacao": "bd9f169543e74b54b848ded6494a96ec", "momento_real": "2026-09-20T18:48:22+00:00", "data_simulacao": "2026-05-31", "evento": "incorreto", "usuario": "avaliacao", "perfil": "gestor", "pergunta": "Qual sera a ocupacao do hospital amanha?", "sql": "SELECT \n    total_leitos, \n    ocupados + (total_leitos - ocupados) * 0.05 AS ocupados_amanha, \n    livres - (total_leitos - ocupados) * 0.05 AS livres_amanha, \n    bloqueados\nFROM \n    gold.ocupacao_diaria\nWHERE \n    data = '2026-05-31';", "motor": "local", "controle": null, "motivo": null, "hash_resultado": "6eb898cb98c8ab9bba379367b172d756ee5409857c15cf03166fa05d442a2a31", "n_linhas": 1, "hash_anterior": "e4849fe6d714e1d2a08459e4ad2055970b9f5d9df05382a80fcabccae167f591", "hash": "05235df1335a72b883678a53f2e5729b421a7459088fc199611178a7e4471137"}
