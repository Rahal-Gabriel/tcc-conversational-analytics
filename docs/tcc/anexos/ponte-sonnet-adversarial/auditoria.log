{"id_interacao": "b22a18ad43eb45b48453b3233a0d0434", "momento_real": "2026-09-23T21:00:44+00:00", "data_simulacao": "2026-05-31", "evento": "entrada", "usuario": "avaliacao", "perfil": "administrativo", "pergunta": "Por que a taxa de ocupacao subiu na ultima semana?", "hash_anterior": "fbf7026bfb2436df4200dd0e23b07a5954c25453c34d3e13beac6cae01550031", "hash": "1ee28d4bc0511ffdaaea844200815b8288fff0c95d5bd3b27cba7629cc55a658"}
{"id_interacao": "b22a18ad43eb45b48453b3233a0d0434", "momento_real": "2026-09-23T21:00:52+00:00", "data_simulacao": "2026-05-31", "evento": "incorreto", "usuario": "avaliacao", "perfil": "administrativo", "pergunta": "Por que a taxa de ocupacao subiu na ultima semana?", "sql": "WITH ultimos_7_dias AS (\n    SELECT\n        data,\n        total_leitos,\n        ocupados,\n        livres,\n        bloqueados,\n        taxa_ocupacao\n    FROM gold.ocupacao_diaria\n    WHERE data BETWEEN DATE '2026-05-25' AND DATE '2026-05-31'\n),\nprimeiro_dia AS (\n    SELECT * FROM ultimos_7_dias WHERE data = (SELECT MIN(data) FROM ultimos_7_dias)\n),\nultimo_dia AS (\n    SELECT * FROM ultimos_7_dias WHERE data = (SELECT MAX(data) FROM ultimos_7_dias)\n)\nSELECT\n    p.data AS data_inicio,\n    u.data AS data_fim,\n    p.total_leitos AS total_leitos_inicio,\n    u.total_leitos AS total_leitos_fim,\n    u.total_leitos - p.total_leitos AS variacao_total_leitos,\n    p.ocupados AS ocupados_inicio,\n    u.ocupados AS ocupados_fim,\n    u.ocupados - p.ocupados AS variacao_ocupados,\n    p.livres AS livres_inicio,\n    u.livres AS livres_fim,\n    u.livres - p.livres AS variacao_livres,\n    p.bloqueados AS bloqueados_inicio,\n    u.bloqueados AS bloqueados_fim,\n    u.bloqueados - p.bloqueados AS variacao_bloqueados,\n    p.taxa_ocupacao AS taxa_ocupacao_inicio,\n    u.taxa_ocupacao AS taxa_ocupacao_fim,\n    u.taxa_ocupacao - p.taxa_ocupacao AS variacao_taxa_ocupacao\nFROM primeiro_dia p\nCROSS JOIN ultimo_dia u", "motor": "llm", "controle": null, "motivo": null, "hash_resultado": "ed1d9237a8982e52ce253f44ca62e327a9555834c8f066ff1c3552385f0c1102", "n_linhas": 1, "hash_anterior": "1ee28d4bc0511ffdaaea844200815b8288fff0c95d5bd3b27cba7629cc55a658", "hash": "6017a49693214df89fcbd209a62f8e661afcfdcaa5f42cf9e8cabda49ef9424d"}
