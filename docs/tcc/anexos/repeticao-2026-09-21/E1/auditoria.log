{"id_interacao": "cda47386a98f4463b1221655bcdebcb3", "momento_real": "2026-09-21T21:23:55+00:00", "data_simulacao": "2026-05-31", "evento": "incorreto", "usuario": "avaliacao", "perfil": "administrativo", "pergunta": "Por que a taxa de ocupacao subiu na ultima semana?", "sql": "SELECT \n    data, \n    taxa_ocupacao, \n    LAG(taxa_ocupacao) OVER (ORDER BY data) AS taxa_ocupacao_anterior,\n    taxa_ocupacao - LAG(taxa_ocupacao) OVER (ORDER BY data) AS variancia_taxa\nFROM \n    gold.ocupacao_diaria\nWHERE \n    data >= DATE('2026-05-31') - INTERVAL '7 days'\nORDER BY \n    data;", "motor": "local", "controle": null, "motivo": null, "hash_resultado": "4b730c4aea733fab0342755858f6dddd838cf08d63b7462015cfa0c357b2e378", "n_linhas": 8, "hash_anterior": "b82336f007765185bd7e9e1ec351aea1cd5c48991234eacccd53715f72179790", "hash": "6d84d0c7544f3f6fe84b4b66fd73ea6df6f5fd116e36fee92407b472430975a2"}
