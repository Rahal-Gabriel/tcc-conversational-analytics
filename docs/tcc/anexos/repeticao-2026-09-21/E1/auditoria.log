{"id_interacao": "ebc2bf839cf44961be1bca69560b1148", "momento_real": "2026-09-21T21:29:21+00:00", "data_simulacao": "2026-05-31", "evento": "incorreto", "usuario": "avaliacao", "perfil": "gestor", "pergunta": "Qual sera a ocupacao do hospital amanha?", "sql": "SELECT \n    total_leitos, \n    ocupados + (total_leitos - ocupados) * 0.05 AS ocupados_amanha, \n    livres - (total_leitos - ocupados) * 0.05 AS livres_amanha, \n    bloqueados\nFROM \n    gold.ocupacao_diaria\nWHERE \n    data = '2026-05-31';", "motor": "local", "controle": null, "motivo": null, "hash_resultado": "6eb898cb98c8ab9bba379367b172d756ee5409857c15cf03166fa05d442a2a31", "n_linhas": 1, "hash_anterior": "9164b1681b9b7c164ff8a308fdf73e12f60f6089236cbb0aaa55599f71e2d168", "hash": "d583c967a4a39851965e59d8b3eeab2d1fdf75f34159bf3e809ae8d91115a29b"}
